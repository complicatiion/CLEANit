<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:CLEANit.App.Controls"
             x:Class="CLEANit.App.Views.RuleEditorView">
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Command="{Binding AddRuleCommand}">
          <ctl:IconLabel Icon="{StaticResource IconPlus}" Text="{DynamicResource BtnNewRule}" />
        </Button>
        <Button Classes="icon delete" Command="{Binding DeleteRuleCommand}" IsEnabled="{Binding HasSelection}" ToolTip.Tip="{DynamicResource BtnDelete}">
          <PathIcon Data="{StaticResource IconDelete}" />
        </Button>
        <Button Classes="icon" Command="{Binding OpenFolderCommand}" ToolTip.Tip="{DynamicResource BtnOpenFolder}">
          <PathIcon Data="{StaticResource IconFolderOpen}" />
        </Button>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
        <Button Classes="fixed" Command="{Binding RevertCommand}">
          <ctl:IconLabel Icon="{StaticResource IconUndo}" Text="{DynamicResource BtnRevert}" />
        </Button>
        <Button Classes="primary fixed" Command="{Binding SaveCommand}">
          <ctl:IconLabel Icon="{StaticResource IconSave}" Text="{DynamicResource BtnSaveRules}" />
        </Button>
      </StackPanel>
    </Grid>

    <TextBlock DockPanel.Dock="Bottom" Classes="muted small" Text="{DynamicResource RuleEditorNote}" TextWrapping="Wrap" Margin="0,12,0,0" />

    <Grid ColumnDefinitions="260,14,*,14,*">
      <!-- Rule list -->
      <Border Classes="card" Padding="6">
        <Grid>
          <TextBlock Classes="muted" Text="{DynamicResource RuleEditorEmpty}" IsVisible="{Binding !HasRules}" TextWrapping="Wrap" Margin="12" />
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Rules}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="tablerow" Classes.active="{Binding IsActive}" CornerRadius="6">
                    <Button Classes="row" Command="{Binding $parent[UserControl].DataContext.SelectCommand}" CommandParameter="{Binding}">
                      <StackPanel>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="mono small muted" Text="{Binding Id}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Button>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- Rule fields -->
      <Border Grid.Column="2" Classes="card" IsVisible="{Binding HasSelection}">
        <ScrollViewer>
          <StackPanel Spacing="10" DataContext="{Binding Selected}">
            <TextBlock Classes="label" Text="{DynamicResource LblRuleId}" />
            <TextBox Text="{Binding Id}" FontFamily="{DynamicResource MonoFont}" />
            <Grid ColumnDefinitions="*,10,*">
              <StackPanel>
                <TextBlock Classes="label" Text="{DynamicResource LblRuleName}" />
                <TextBox Text="{Binding Name}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Classes="label" Text="{DynamicResource LblRuleNameDe}" />
                <TextBox Text="{Binding NameDe}" />
              </StackPanel>
            </Grid>
            <TextBlock Classes="label" Text="{DynamicResource LblDescription}" />
            <TextBox Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" />
            <Grid ColumnDefinitions="*,10,*,10,*">
              <StackPanel>
                <TextBlock Classes="label" Text="{DynamicResource LblArea}" />
                <ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.Areas}" SelectedIndex="{Binding AreaIndex}" HorizontalAlignment="Stretch" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Classes="label" Text="{DynamicResource LblCategory}" />
                <TextBox Text="{Binding Category}" />
              </StackPanel>
              <StackPanel Grid.Column="4">
                <TextBlock Classes="label" Text="{DynamicResource LblRisk}" />
                <ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.Risks}" SelectedIndex="{Binding RiskIndex}" HorizontalAlignment="Stretch" />
              </StackPanel>
            </Grid>
            <TextBlock Classes="label" Text="{DynamicResource LblProcesses}" />
            <TextBox Text="{Binding Processes}" Watermark="chrome; msedge" />
            <TextBlock Classes="label" Text="{DynamicResource LblWarning}" />
            <TextBox Text="{Binding Warning}" />
            <CheckBox IsChecked="{Binding UseRecycleBin}" Content="{DynamicResource LblRuleRecycleBin}" />

            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
              <TextBlock Classes="section" Text="{DynamicResource HdrTargets}" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="icon" Command="{Binding $parent[UserControl].DataContext.AddTargetCommand}" ToolTip.Tip="{DynamicResource BtnAddTarget}">
                <PathIcon Data="{StaticResource IconPlus}" />
              </Button>
            </Grid>
            <ItemsControl ItemsSource="{Binding Targets}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="raised" Padding="10" CornerRadius="8" Margin="0,0,0,8">
                    <StackPanel Spacing="6">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBox Text="{Binding Path}" Watermark="%LocalAppData%\Vendor\App\Cache" FontFamily="{DynamicResource MonoFont}" />
                        <Button Grid.Column="1" Classes="icon small delete" Margin="6,0,0,0" ToolTip.Tip="{DynamicResource TipRemove}"
                                Command="{Binding $parent[UserControl].DataContext.RemoveTargetCommand}" CommandParameter="{Binding}">
                          <PathIcon Data="{StaticResource IconDelete}" />
                        </Button>
                      </Grid>
                      <Grid ColumnDefinitions="*,10,130">
                        <TextBox Text="{Binding Pattern}" Watermark="*.tmp;*.log" FontFamily="{DynamicResource MonoFont}" ToolTip.Tip="{DynamicResource TipPattern}" />
                        <NumericUpDown Grid.Column="2" Value="{Binding MinAgeHours}" Minimum="0" Maximum="87600" FormatString="0" ToolTip.Tip="{DynamicResource TipMinAge}" />
                      </Grid>
                      <TextBox Text="{Binding Exclude}" Watermark="{DynamicResource WatermarkExclude}" FontFamily="{DynamicResource MonoFont}" />
                      <WrapPanel>
                        <CheckBox IsChecked="{Binding Recursive}" Content="{DynamicResource LblRecursive}" Margin="0,0,16,0" />
                        <CheckBox IsChecked="{Binding RemoveEmptyDirs}" Content="{DynamicResource LblRemoveEmptyDirs}" />
                      </WrapPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Classes="section" Text="{DynamicResource HdrTokens}" Margin="0,6,0,0" />
            <ItemsControl ItemsSource="{Binding $parent[UserControl].DataContext.Tokens}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Classes="link" Margin="0,0,12,6" Command="{Binding $parent[UserControl].DataContext.CopyTokenCommand}" CommandParameter="{Binding}"
                          ToolTip.Tip="{DynamicResource TipCopy}">
                    <TextBlock Classes="mono small" Text="{Binding}" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Preview with guard verdicts -->
      <Border Grid.Column="4" Classes="card" IsVisible="{Binding HasSelection}">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <TextBlock Classes="h3" Text="{DynamicResource HdrPreview}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Command="{Binding PreviewCommand}" IsEnabled="{Binding !IsBusy}">
              <ctl:IconLabel Icon="{StaticResource IconAnalyze}" Text="{DynamicResource BtnPreview}" />
            </Button>
          </Grid>
          <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Margin="0,0,0,8" />
          <TextBlock DockPanel.Dock="Top" Text="{Binding PreviewText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
          <ScrollViewer HorizontalScrollBarVisibility="Auto">
            <StackPanel Spacing="8">
              <TextBlock Classes="section" Text="{DynamicResource HdrFolders}" />
              <ItemsControl ItemsSource="{Binding PreviewRoots}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Data="{StaticResource IconCheckCircle}" Width="13" Height="13" Foreground="{DynamicResource BrushSafe}" />
                      <TextBlock Classes="mono small" Text="{Binding}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="section" Text="{DynamicResource HdrBlocked}" />
              <ItemsControl ItemsSource="{Binding PreviewBlocked}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Data="{StaticResource IconShieldAlert}" Width="13" Height="13" Foreground="{DynamicResource BrushDeep}" />
                      <TextBlock Classes="mono small" Text="{Binding}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="section" Text="{DynamicResource HdrLargestFiles}" />
              <ItemsControl ItemsSource="{Binding PreviewSamples}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Classes="mono small muted" Text="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
