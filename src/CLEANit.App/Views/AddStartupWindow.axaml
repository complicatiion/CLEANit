<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:CLEANit.App.Controls"
        x:Class="CLEANit.App.Views.AddStartupWindow"
        Icon="/Assets/cleanit.ico"
        Width="600"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Border Padding="26,24">
    <StackPanel Spacing="14">
      <StackPanel Spacing="4" HorizontalAlignment="Center">
        <PathIcon Data="{StaticResource IconStartup}" Width="30" Height="30" Foreground="{DynamicResource BrushAccentText}" HorizontalAlignment="Center" />
        <TextBlock Classes="h2" Text="{DynamicResource StartupAddTitle}" HorizontalAlignment="Center" />
        <TextBlock Classes="muted" Text="{DynamicResource StartupAddText}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="500" />
      </StackPanel>

      <Grid ColumnDefinitions="130,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
        <TextBlock Text="{DynamicResource LblStartupProgram}" VerticalAlignment="Center" />
        <TextBox x:Name="TargetBox" Grid.Column="1" IsReadOnly="True" Classes="mono" FontSize="12" Watermark="C:\Program Files\…\app.exe" />
        <Button Grid.Column="2" Margin="8,0,0,0" Click="OnBrowse">
          <ctl:IconLabel Icon="{StaticResource IconFolderOpen}" Text="{DynamicResource BtnBrowse}" />
        </Button>
        <TextBlock Grid.Row="1" Margin="0,10,0,0" Text="{DynamicResource LblStartupName}" VerticalAlignment="Center" />
        <TextBox x:Name="NameBox" Grid.Row="1" Margin="0,10,0,0" Grid.Column="1" Grid.ColumnSpan="2" />
        <TextBlock Grid.Row="2" Margin="0,10,0,0" Text="{DynamicResource LblStartupArguments}" VerticalAlignment="Center" />
        <TextBox x:Name="ArgumentsBox" Grid.Row="2" Margin="0,10,0,0" Grid.Column="1" Grid.ColumnSpan="2" Classes="mono" FontSize="12" Watermark="--minimized" />
        <TextBlock x:Name="ScopeLabel" Grid.Row="3" Margin="0,10,0,0" Text="{DynamicResource LblStartupAllUsers}" VerticalAlignment="Center" />
        <ToggleSwitch x:Name="AllUsersSwitch" Grid.Row="3" Margin="0,10,0,0" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" />
      </Grid>
      <TextBlock Classes="muted small" Text="{DynamicResource StartupAddNote}" TextWrapping="Wrap" />

      <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,4,0,0">
        <Button Classes="fixed" Click="OnCancel" IsCancel="True">
          <ctl:IconLabel Icon="{StaticResource IconClose}" Text="{DynamicResource BtnCancel}" />
        </Button>
        <Button x:Name="AddButton" Classes="primary fixed" Click="OnAdd" IsEnabled="False">
          <ctl:IconLabel Icon="{StaticResource IconPlus}" Text="{DynamicResource BtnAddEntry}" />
        </Button>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
