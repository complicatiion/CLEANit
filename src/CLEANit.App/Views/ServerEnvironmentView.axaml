<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:CLEANit.App.Controls"
             x:Class="CLEANit.App.Views.ServerEnvironmentView">
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,12">
      <ProgressBar IsIndeterminate="True" Width="160" HorizontalAlignment="Left" VerticalAlignment="Center" IsVisible="{Binding IsBusy}" />
      <Button Grid.Column="1" Margin="0,0,8,0" Command="{Binding OpenProfilesCommand}">
        <ctl:IconLabel Icon="{StaticResource IconAccountMultiple}" Text="{DynamicResource NavProfiles}" />
      </Button>
      <Button Grid.Column="2" Margin="0,0,8,0" Command="{Binding OpenServerCleanCommand}">
        <ctl:IconLabel Icon="{StaticResource IconServer}" Text="{DynamicResource NavServerClean}" />
      </Button>
      <Button Grid.Column="3" Classes="primary" Command="{Binding RefreshCommand}">
        <ctl:IconLabel Icon="{StaticResource IconRefresh}" Text="{DynamicResource BtnRefresh}" />
      </Button>
    </Grid>
    <TextBlock DockPanel.Dock="Bottom" Classes="muted small" Text="{DynamicResource EnvNote}" TextWrapping="Wrap" Margin="0,10,0,0" />

    <ScrollViewer>
      <!-- 4 cards per row over the full width (2 / 1 in narrow windows); the item width is set in code-behind -->
      <ItemsControl x:Name="Cards" ItemsSource="{Binding Groups}" Margin="0,0,-12,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel ItemWidth="{Binding $parent[ItemsControl].Tag}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Classes="card" Margin="0,0,12,12" Padding="16,14">
              <StackPanel Spacing="8">
                <TextBlock Classes="h3" Text="{Binding Title}" />
                <ItemsControl ItemsSource="{Binding Items}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                        <TextBlock Classes="muted small" Text="{Binding Label}" IsVisible="{Binding HasLabel}" Width="190" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding Label}" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" Classes="small" Classes.mono="{Binding IsRaw}" Classes.accent="{Binding IsOk}"
                                   Classes.warning="{Binding IsWarning}" Classes.muted="{Binding IsOff}" Text="{Binding Value}" TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
