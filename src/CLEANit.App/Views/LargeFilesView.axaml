<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:CLEANit.App.Controls"
             x:Class="CLEANit.App.Views.LargeFilesView">
  <DockPanel>

    <!-- Search options -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,0,0,12">
      <TextBox Text="{Binding Root}" Watermark="{DynamicResource WatermarkFolder}">
        <TextBox.InnerLeftContent>
          <PathIcon Data="{StaticResource IconFolder}" Width="16" Height="16" Margin="10,0,0,0" Opacity="0.7" />
        </TextBox.InnerLeftContent>
      </TextBox>
      <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding BrowseCommand}">
        <ctl:IconLabel Icon="{StaticResource IconFolderOpen}" Text="{DynamicResource BtnBrowse}" />
      </Button>
      <TextBlock Grid.Column="2" Classes="muted" Text="{DynamicResource LblMinSizeMb}" VerticalAlignment="Center" Margin="16,0,8,0" />
      <NumericUpDown Grid.Column="3" Value="{Binding MinMb}" Minimum="1" Maximum="1000000" Increment="50" FormatString="0" Width="130" />
      <TextBlock Grid.Column="4" Classes="muted" Text="{DynamicResource LblOlderDays}" VerticalAlignment="Center" Margin="16,0,8,0" />
      <NumericUpDown Grid.Column="5" Value="{Binding OlderDays}" Minimum="0" Maximum="3650" Increment="30" FormatString="0" Width="130"
                     ToolTip.Tip="{DynamicResource TipOlderDays}" />
      <Button Grid.Column="6" Margin="8,0,0,0" Classes="primary" Command="{Binding ScanCommand}">
        <ctl:IconLabel Icon="{StaticResource IconAnalyze}" Text="{DynamicResource BtnScan}" />
      </Button>
      <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
        <Button Classes="icon" Command="{Binding SelectAllCommand}" ToolTip.Tip="{DynamicResource TipSelectAll}">
          <PathIcon Data="{StaticResource IconSelectAll}" />
        </Button>
        <Button Classes="icon" Command="{Binding SelectNoneCommand}" ToolTip.Tip="{DynamicResource TipSelectNone}">
          <PathIcon Data="{StaticResource IconSelectNone}" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- Action bar -->
    <Border DockPanel.Dock="Bottom" Classes="card" Padding="16,12" Margin="0,12,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel VerticalAlignment="Center" Spacing="4">
          <TextBlock Text="{Binding SummaryText}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Classes="muted small" Text="{Binding ModeText}" TextWrapping="Wrap" />
          <StackPanel Spacing="4" IsVisible="{Binding IsBusy}">
            <ProgressBar IsIndeterminate="True" />
            <TextBlock Classes="muted small" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="16,0,0,0">
          <Button Classes="fixed cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}">
            <ctl:IconLabel Icon="{StaticResource IconCancel}" Text="{DynamicResource BtnCancel}" />
          </Button>
          <Button Classes="danger fixed" Command="{Binding DeleteCommand}">
            <ctl:IconLabel Icon="{StaticResource IconDelete}" Text="{DynamicResource BtnDeleteSelected}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid>
      <TextBlock Classes="muted" Text="{DynamicResource LargeFilesEmpty}" IsVisible="{Binding !HasRows}" HorizontalAlignment="Center" Margin="0,40" TextWrapping="Wrap" />
      <DataGrid ItemsSource="{Binding Rows}" IsVisible="{Binding HasRows}">
        <DataGrid.Columns>
          <DataGridTemplateColumn Width="44" CanUserSort="False" CanUserReorder="False" CanUserResize="False">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" HorizontalAlignment="Center" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Width="2*" SortMemberPath="Name">
            <DataGridTemplateColumn.Header>
              <TextBlock Text="{DynamicResource ColName}" />
            </DataGridTemplateColumn.Header>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                  <TextBlock Classes="muted small" Text="{Binding AgeText}" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Width="2*" SortMemberPath="Folder">
            <DataGridTemplateColumn.Header>
              <TextBlock Text="{DynamicResource ColFolder}" />
            </DataGridTemplateColumn.Header>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Classes="mono small muted" Text="{Binding Folder}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Folder}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Width="110" SortMemberPath="Bytes">
            <DataGridTemplateColumn.Header>
              <TextBlock Text="{DynamicResource ColSize}" />
            </DataGridTemplateColumn.Header>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Size}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Width="110" SortMemberPath="LastWriteUtc">
            <DataGridTemplateColumn.Header>
              <TextBlock Text="{DynamicResource ColModified}" />
            </DataGridTemplateColumn.Header>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Classes="muted" Text="{Binding Modified}" HorizontalAlignment="Right" VerticalAlignment="Center" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Width="110" SortMemberPath="LastAccessUtc">
            <DataGridTemplateColumn.Header>
              <TextBlock Text="{DynamicResource ColAccessed}" />
            </DataGridTemplateColumn.Header>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Classes="muted" Text="{Binding Accessed}" HorizontalAlignment="Right" VerticalAlignment="Center" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Width="50" CanUserSort="False" CanUserReorder="False">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Button Classes="icon small" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip.Tip="{DynamicResource TipOpenFolder}"
                        Command="{Binding $parent[UserControl].DataContext.OpenFolderCommand}" CommandParameter="{Binding}">
                  <PathIcon Data="{StaticResource IconFolderOpen}" />
                </Button>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
  </DockPanel>
</UserControl>
