<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:CLEANit.App.Controls"
        x:Class="CLEANit.App.Views.ConfirmWindow"
        Icon="/Assets/cleanit.ico"
        Width="520"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Border Padding="24">
    <!-- Icon, text and buttons centered; Cancel left of the main action -->
    <StackPanel Spacing="14" HorizontalAlignment="Center">
      <PathIcon x:Name="Glyph" Width="36" Height="36" HorizontalAlignment="Center" />
      <TextBlock x:Name="HeaderText" Classes="h2" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
      <TextBlock x:Name="MessageText" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="460" />
      <!-- Option (restore point, replace files …) as a switch, off unless the caller says otherwise -->
      <StackPanel x:Name="OptionRow" Orientation="Horizontal" Spacing="10" IsVisible="False" HorizontalAlignment="Center">
        <ToggleSwitch x:Name="OptionCheck" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" />
        <TextBlock x:Name="OptionText" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="380" />
      </StackPanel>
      <TextBox x:Name="InputBox" IsVisible="False" Width="340" HorizontalAlignment="Center" />
      <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,6,0,0">
        <Button x:Name="CancelButton" Click="OnCancel" IsCancel="True" Classes="fixed">
          <ctl:IconLabel Icon="{StaticResource IconClose}" Text="{DynamicResource BtnCancel}" />
        </Button>
        <Button x:Name="ConfirmButton" Click="OnConfirm" Classes="primary fixed" IsDefault="True">
          <ctl:IconLabel x:Name="ConfirmLabel" Icon="{StaticResource IconCheck}" />
        </Button>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
