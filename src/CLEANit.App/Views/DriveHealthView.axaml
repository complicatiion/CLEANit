<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:CLEANit.App.Controls"
             x:Class="CLEANit.App.Views.DriveHealthView">
  <Grid RowDefinitions="Auto,*,Auto,Auto">

    <!-- Toolbar: progress / last refresh · auto refresh pill · Refresh -->
    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <ProgressBar IsIndeterminate="True" Width="160" VerticalAlignment="Center" IsVisible="{Binding IsBusy}" />
        <TextBlock Classes="muted small" Text="{Binding LastRefreshText}" VerticalAlignment="Center" IsVisible="{Binding !IsBusy}" />
      </StackPanel>
      <Border Grid.Column="1" Classes="pill accent" Margin="0,0,10,0" IsVisible="{Binding HasAutoRefresh}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <PathIcon Data="{StaticResource IconTimerSand}" Width="12" Height="12" />
          <TextBlock Text="{Binding AutoRefreshText}" />
        </StackPanel>
      </Border>
      <Button Grid.Column="2" Classes="primary" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}">
        <ctl:IconLabel Icon="{StaticResource IconRefresh}" Text="{DynamicResource BtnRefresh}" />
      </Button>
    </Grid>

    <!-- Drive cards: up to four per row -->
    <Grid Grid.Row="1">
      <TextBlock Classes="muted" Text="{DynamicResource DriveHealthEmpty}" IsVisible="{Binding !HasRows}" HorizontalAlignment="Center" Margin="0,30" TextWrapping="Wrap" />
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Rows}" Margin="0,0,-12,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="{Binding $parent[UserControl].DataContext.DriveColumns}" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <!-- The whole card opens the details (all values and the SMART table) -->
              <Button Classes="cardlink" Margin="0,0,12,12" ToolTip.Tip="{DynamicResource TipDriveDetails}"
                      Command="{Binding $parent[UserControl].DataContext.SelectCommand}" CommandParameter="{Binding}">
              <Border Classes="card drive" Classes.selected="{Binding IsSelected}" Padding="16,14">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <PathIcon Data="{StaticResource IconHarddisk}" Width="20" Height="20" Foreground="{DynamicResource BrushCatSystem}"
                              Margin="0,0,10,0" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Spacing="1">
                      <TextBlock Classes="h3" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                      <TextBlock Classes="muted small" Text="{Binding Kind}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Grid.Column="2" Classes="badge" Classes.safe="{Binding IsGood}" Classes.moderate="{Binding IsCaution}"
                            Classes.deep="{Binding IsBad}" VerticalAlignment="Top" Margin="8,0,0,0">
                      <TextBlock Text="{Binding AssessmentText}" />
                    </Border>
                  </Grid>

                  <!-- Life left -->
                  <StackPanel Spacing="4" IsVisible="{Binding HasLife}">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="muted small" Text="{DynamicResource DriveLife}" />
                      <TextBlock Grid.Column="1" Classes="small" Text="{Binding Life}" FontWeight="SemiBold" />
                    </Grid>
                    <ProgressBar Classes="usage" Value="{Binding LifePercent}" Maximum="100" />
                  </StackPanel>

                  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                    <TextBlock Classes="muted small" Text="{DynamicResource LblTemperature}" />
                    <TextBlock Grid.Column="1" Classes="small" Classes.deep="{Binding IsHot}" Text="{Binding Temperature}"
                               HorizontalAlignment="Right" />
                    <TextBlock Grid.Row="1" Classes="muted small" Text="{DynamicResource LblPowerOn}" Margin="0,5,12,0" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="small" Text="{Binding PowerOn}" HorizontalAlignment="Right"
                               TextTrimming="CharacterEllipsis" Margin="0,5,0,0" />
                    <TextBlock Grid.Row="2" Classes="muted small" Text="{DynamicResource DrivePowerCycles}" Margin="0,5,12,0" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Classes="small" Text="{Binding PowerCycles}" HorizontalAlignment="Right" Margin="0,5,0,0" />
                    <TextBlock Grid.Row="3" Classes="muted small" Text="{DynamicResource DriveWritten}" Margin="0,5,12,0" IsVisible="{Binding HasTransfer}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Classes="small" Text="{Binding Written}" HorizontalAlignment="Right" Margin="0,5,0,0"
                               IsVisible="{Binding HasTransfer}" />
                    <TextBlock Grid.Row="4" Classes="muted small" Text="{DynamicResource LblErrors}" Margin="0,5,12,0" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Classes="small" Classes.deep="{Binding HasErrors}" Text="{Binding Errors}"
                               HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Errors}" Margin="0,5,0,0" />
                    <TextBlock Grid.Row="5" Classes="muted small" Text="{DynamicResource DriveVolumes}" Margin="0,5,12,0" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Classes="small mono" Text="{Binding Volumes}" HorizontalAlignment="Right" Margin="0,5,0,0" />
                  </Grid>

                  <TextBlock Classes="small" Classes.deep="{Binding IsBad}" Classes.moderate="{Binding IsCaution}" Text="{Binding Findings}"
                             TextWrapping="Wrap" IsVisible="{Binding HasFindings}" />

                  <Grid ColumnDefinitions="*,Auto">
                    <!-- Data source and the details chevron in the accent colour -->
                    <TextBlock Classes="small accent" Text="{Binding SourceText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <PathIcon Grid.Column="1" Classes="chevron" Classes.expanded="{Binding IsSelected}" Data="{StaticResource IconChevronRight}"
                              Width="14" Height="14" Foreground="{DynamicResource BrushAccentText}" />
                  </Grid>
                </StackPanel>
              </Border>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <!-- Details of the selected drive: all values and the SMART table -->
    <Border Grid.Row="2" Classes="card" Padding="16,12" Margin="0,4,0,0" MaxHeight="420" IsVisible="{Binding HasSelection}">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <PathIcon Data="{StaticResource IconHarddisk}" Width="18" Height="18" Foreground="{DynamicResource BrushAccentText}" />
            <TextBlock Classes="h3" Text="{Binding Selected.Name}" VerticalAlignment="Center" />
          </StackPanel>
          <Button Grid.Column="1" Classes="icon small" ToolTip.Tip="{DynamicResource BtnClose}" Command="{Binding CloseDetailsCommand}">
            <PathIcon Data="{StaticResource IconClose}" />
          </Button>
        </Grid>
        <Grid ColumnDefinitions="340,16,*">
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Selected.Details}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="150,*" Margin="0,2">
                    <TextBlock Classes="muted small" Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}" />
                    <TextBlock Grid.Column="1" Classes="small" Text="{Binding Value}" TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <Grid Grid.Column="2">
            <TextBlock Classes="muted small" Text="{DynamicResource DriveNoSmart}" TextWrapping="Wrap" IsVisible="{Binding !Selected.HasAttributes}" />
            <DataGrid ItemsSource="{Binding Selected.Attributes}" IsVisible="{Binding Selected.HasAttributes}" RowHeight="30">
              <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Id}" Width="52" SortMemberPath="IdSort">
                  <DataGridTextColumn.Header>
                    <TextBlock Text="ID" />
                  </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTemplateColumn Width="2*" MinWidth="160" SortMemberPath="Name">
                  <DataGridTemplateColumn.Header>
                    <TextBlock Text="{DynamicResource ColName}" />
                  </DataGridTemplateColumn.Header>
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Classes="small" Classes.deep="{Binding IsFailing}" Text="{Binding Name}" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Type}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Binding="{Binding Current}" Width="100" MinWidth="90">
                  <DataGridTextColumn.Header>
                    <TextBlock Text="{DynamicResource ColSmartCurrent}" />
                  </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Worst}" Width="120" MinWidth="100">
                  <DataGridTextColumn.Header>
                    <TextBlock Text="{DynamicResource ColSmartWorst}" />
                  </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Threshold}" Width="110" MinWidth="95">
                  <DataGridTextColumn.Header>
                    <TextBlock Text="{DynamicResource ColSmartThreshold}" />
                  </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding RawText}" Width="1.2*" MinWidth="140" SortMemberPath="Raw">
                  <DataGridTextColumn.Header>
                    <TextBlock Text="{DynamicResource ColSmartRaw}" />
                  </DataGridTextColumn.Header>
                </DataGridTextColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Grid>
      </DockPanel>
    </Border>

    <TextBlock Grid.Row="3" Classes="muted small" Text="{DynamicResource DriveHealthNote}" TextWrapping="Wrap" Margin="0,10,0,0" />
  </Grid>
</UserControl>
