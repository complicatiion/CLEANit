<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:CLEANit.App.Controls"
        x:Class="CLEANit.App.Views.ChecklistWindow"
        Icon="/Assets/cleanit.ico"
        Width="720" Height="520"
        MinWidth="520" MinHeight="360"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="22">
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,12">
      <TextBlock x:Name="HeaderText" Classes="h2" />
      <TextBlock x:Name="MessageText" Classes="muted" TextWrapping="Wrap" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Classes="fixed" Click="OnCancel" IsCancel="True">
        <ctl:IconLabel Icon="{StaticResource IconClose}" Text="{DynamicResource BtnCancel}" />
      </Button>
      <Button x:Name="ConfirmButton" Classes="primary fixed" Click="OnConfirm">
        <ctl:IconLabel x:Name="ConfirmLabel" />
      </Button>
    </StackPanel>
    <Border Classes="card" Padding="4">
      <ScrollViewer>
        <ItemsControl x:Name="List">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="tablerow">
                <CheckBox IsChecked="{Binding IsChecked}">
                  <StackPanel>
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                    <TextBlock Classes="muted small" Text="{Binding Detail}" />
                  </StackPanel>
                </CheckBox>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
  </DockPanel>
</Window>
