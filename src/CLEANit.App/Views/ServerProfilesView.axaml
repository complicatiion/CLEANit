<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:CLEANit.App.Controls"
             x:Class="CLEANit.App.Views.ServerProfilesView">
  <DockPanel>

    <!-- Toolbar: select profiles unused for n days · refresh -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="0,0,0,12">
      <TextBlock Text="{DynamicResource LblProfileAge}" VerticalAlignment="Center" Margin="0,0,8,0" />
      <NumericUpDown Grid.Column="1" Value="{Binding AgeDays}" Minimum="1" Maximum="3650" Increment="30" FormatString="0" Width="130" />
      <Button Grid.Column="2" Margin="8,0,0,0" Command="{Binding SelectOldCommand}" ToolTip.Tip="{DynamicResource TipSelectOldProfiles}">
        <ctl:IconLabel Icon="{StaticResource IconAccountClock}" Text="{DynamicResource BtnSelectOld}" />
      </Button>
      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" Margin="6,0,0,0">
        <Button Classes="icon" Command="{Binding SelectAllCommand}" ToolTip.Tip="{DynamicResource TipSelectAllProfiles}">
          <PathIcon Data="{StaticResource IconSelectAll}" />
        </Button>
        <Button Classes="icon" Command="{Binding SelectNoneCommand}" ToolTip.Tip="{DynamicResource TipSelectNone}">
          <PathIcon Data="{StaticResource IconSelectNone}" />
        </Button>
      </StackPanel>
      <Button Grid.Column="5" Classes="primary" Command="{Binding RefreshCommand}">
        <ctl:IconLabel Icon="{StaticResource IconRefresh}" Text="{DynamicResource BtnRefresh}" />
      </Button>
    </Grid>

    <!-- Action bar -->
    <Border DockPanel.Dock="Bottom" Classes="card" Padding="16,12" Margin="0,12,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel VerticalAlignment="Center" Spacing="4">
          <TextBlock Text="{Binding SummaryText}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Classes="muted small" Text="{DynamicResource ProfilesNote}" TextWrapping="Wrap" />
          <StackPanel Spacing="4" IsVisible="{Binding IsBusy}">
            <ProgressBar IsIndeterminate="True" />
            <TextBlock Classes="muted small" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </StackPanel>
        <Button Grid.Column="1" Classes="danger fixed" Margin="16,0,0,0" VerticalAlignment="Center" Command="{Binding DeleteCommand}">
          <ctl:IconLabel Icon="{StaticResource IconAccountRemove}" Text="{DynamicResource BtnDeleteProfiles}" />
        </Button>
      </Grid>
    </Border>

    <Grid>
      <TextBlock Classes="muted" Text="{Binding SummaryText}" IsVisible="{Binding !HasRows}" HorizontalAlignment="Center" Margin="0,30" TextWrapping="Wrap" />
      <DataGrid ItemsSource="{Binding Rows}" IsVisible="{Binding HasRows}">
        <DataGrid.Columns>
          <!-- Selection: header check box = all / none; locked profiles show a lock with the reason instead of a check box -->
          <DataGridTemplateColumn Width="52" CanUserSort="False" CanUserReorder="False" CanUserResize="False">
            <DataGridTemplateColumn.Header>
              <CheckBox IsChecked="{Binding $parent[UserControl].DataContext.AllChecked}" IsEnabled="{Binding $parent[UserControl].DataContext.HasDeletable}"
                        ToolTip.Tip="{DynamicResource TipSelectAllProfiles}" ToolTip.ShowOnDisabled="True" MinWidth="0" Padding="0"
                        HorizontalAlignment="Center" />
            </DataGridTemplateColumn.Header>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <CheckBox IsChecked="{Binding IsChecked}" IsVisible="{Binding CanDelete}" MinWidth="0" Padding="0" />
                  <PathIcon Data="{StaticResource IconLock}" Width="15" Height="15" Foreground="{DynamicResource BrushTextSecondary}" Background="Transparent"
                            IsVisible="{Binding !CanDelete}" ToolTip.Tip="{Binding LockReason}" />
                </Panel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Width="2*" SortMemberPath="UserName">
            <DataGridTemplateColumn.Header>
              <TextBlock Text="{DynamicResource ColUser}" />
            </DataGridTemplateColumn.Header>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                  <TextBlock Text="{Binding UserName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding AccountTip}" />
                  <TextBlock Classes="mono small muted" Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Width="140" SortMemberPath="KindText">
            <DataGridTemplateColumn.Header>
              <TextBlock Text="{DynamicResource ColType}" />
            </DataGridTemplateColumn.Header>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border Classes="badge" Classes.moderate="{Binding IsSpecialKind}" HorizontalAlignment="Left" VerticalAlignment="Center">
                  <TextBlock Text="{Binding KindText}" />
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Width="140" SortMemberPath="IsSignedIn">
            <DataGridTemplateColumn.Header>
              <TextBlock Text="{DynamicResource ColState}" />
            </DataGridTemplateColumn.Header>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border Classes="badge" Classes.safe="{Binding IsSignedIn}" HorizontalAlignment="Left" VerticalAlignment="Center">
                  <TextBlock Text="{Binding StateText}" />
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Width="150" SortMemberPath="LastUseSort">
            <DataGridTemplateColumn.Header>
              <TextBlock Text="{DynamicResource ColLastUse}" />
            </DataGridTemplateColumn.Header>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding LastUse}" HorizontalAlignment="Right" />
                  <TextBlock Classes="muted small" Text="{Binding Age}" HorizontalAlignment="Right" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Width="110" SortMemberPath="SizeSort">
            <DataGridTemplateColumn.Header>
              <TextBlock Text="{DynamicResource ColSize}" />
            </DataGridTemplateColumn.Header>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Size}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Width="60" CanUserSort="False" CanUserReorder="False">
            <DataGridTemplateColumn.Header>
              <TextBlock Text="{DynamicResource ColActions}" />
            </DataGridTemplateColumn.Header>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Button Classes="icon small" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip.Tip="{DynamicResource TipOpenFolder}"
                        Command="{Binding $parent[UserControl].DataContext.OpenFolderCommand}" CommandParameter="{Binding}">
                  <PathIcon Data="{StaticResource IconFolderOpen}" />
                </Button>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
  </DockPanel>
</UserControl>
