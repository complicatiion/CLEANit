<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CLEANit.App.Views.ServerScopeBar">
  <!-- Server cleanup: which profiles are cleaned (signed-out users by default) -->
  <Border Classes="notice" Margin="0,0,0,12">
    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
      <PathIcon Data="{StaticResource IconAccountMultiple}" Width="18" Height="18" Foreground="{DynamicResource BrushInfo}" Margin="0,0,10,0"
                VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Text="{Binding ServerScopeText}" TextWrapping="Wrap" VerticalAlignment="Center" />
      <TextBlock Grid.Column="2" Text="{DynamicResource LblIncludeSignedIn}" VerticalAlignment="Center" Margin="12,0,8,0" />
      <ToggleSwitch Grid.Column="3" IsChecked="{Binding IncludeSignedIn}" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" />
    </Grid>
  </Border>
</UserControl>
