<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:CLEANit.App.Controls"
             x:Class="CLEANit.App.Views.WorkspacePanel">
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="0,0,0,12">
      <TextBox Text="{Binding Root}" Watermark="{DynamicResource WatermarkWorkspace}">
        <TextBox.InnerLeftContent>
          <PathIcon Data="{StaticResource IconFolder}" Width="16" Height="16" Margin="10,0,0,0" Opacity="0.7" />
        </TextBox.InnerLeftContent>
      </TextBox>
      <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding BrowseCommand}">
        <ctl:IconLabel Icon="{StaticResource IconFolderOpen}" Text="{DynamicResource BtnBrowse}" />
      </Button>
      <TextBlock Grid.Column="2" Classes="muted" Text="{DynamicResource LblIdleDays}" VerticalAlignment="Center" Margin="16,0,8,0" />
      <NumericUpDown Grid.Column="3" Value="{Binding IdleDays}" Minimum="0" Maximum="3650" Increment="7" FormatString="0" Width="130"
                     ToolTip.Tip="{DynamicResource TipIdleDays}" />
      <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
        <Button Classes="primary" Command="{Binding ScanCommand}">
          <ctl:IconLabel Icon="{StaticResource IconAnalyze}" Text="{DynamicResource BtnScan}" />
        </Button>
        <Button Classes="icon" Command="{Binding SelectAllCommand}" ToolTip.Tip="{DynamicResource TipSelectAll}">
          <PathIcon Data="{StaticResource IconSelectAll}" />
        </Button>
        <Button Classes="icon" Command="{Binding SelectNoneCommand}" ToolTip.Tip="{DynamicResource TipSelectNone}">
          <PathIcon Data="{StaticResource IconSelectNone}" />
        </Button>
      </StackPanel>
    </Grid>

    <Border DockPanel.Dock="Bottom" Classes="card" Padding="16,12" Margin="0,12,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel VerticalAlignment="Center" Spacing="4">
          <TextBlock Text="{Binding SummaryText}" FontWeight="SemiBold" />
          <StackPanel Spacing="4" IsVisible="{Binding IsBusy}">
            <ProgressBar IsIndeterminate="True" />
            <TextBlock Classes="muted small" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="16,0,0,0">
          <Button Classes="fixed cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}">
            <ctl:IconLabel Icon="{StaticResource IconCancel}" Text="{DynamicResource BtnCancel}" />
          </Button>
          <Button Classes="primary fixed" Command="{Binding CleanCommand}">
            <ctl:IconLabel Icon="{StaticResource IconBroom}" Text="{DynamicResource BtnClean}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Top" Classes="tablehead">
      <Grid ColumnDefinitions="36,2*,130,120,100,130,44">
        <TextBlock Classes="section column" Text="" />
        <TextBlock Grid.Column="1" Classes="section column" Text="{DynamicResource ColProject}" />
        <TextBlock Grid.Column="2" Classes="section column" Text="{DynamicResource ColKind}" />
        <TextBlock Grid.Column="3" Classes="section column" Text="{DynamicResource ColFolder}" />
        <TextBlock Grid.Column="4" Classes="section column" Text="{DynamicResource ColSize}" HorizontalAlignment="Right" />
        <TextBlock Grid.Column="5" Classes="section column" Text="{DynamicResource ColLastActivity}" HorizontalAlignment="Right" />
      </Grid>
    </Border>
    <Grid>
      <TextBlock Classes="muted" Text="{DynamicResource WorkspaceEmpty}" IsVisible="{Binding !HasRows}" HorizontalAlignment="Center" Margin="0,30" />
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="tablerow">
                <Grid ColumnDefinitions="36,2*,130,120,100,130,44">
                  <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="{Binding Project}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="muted small" Text="{Binding ProjectPath}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ProjectPath}" />
                  </StackPanel>
                  <Border Grid.Column="2" Classes="badge">
                    <TextBlock Text="{Binding Kind}" />
                  </Border>
                  <TextBlock Grid.Column="3" Classes="mono small" Text="{Binding Folder}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="4" Text="{Binding Size}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LastActivity}" HorizontalAlignment="Right" />
                    <TextBlock Classes="muted small" Text="{Binding IdleText}" HorizontalAlignment="Right" />
                  </StackPanel>
                  <Button Grid.Column="6" Classes="icon small" HorizontalAlignment="Right" ToolTip.Tip="{DynamicResource TipOpenFolder}"
                          Command="{Binding $parent[UserControl].DataContext.OpenFolderCommand}" CommandParameter="{Binding}">
                    <PathIcon Data="{StaticResource IconFolderOpen}" />
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
