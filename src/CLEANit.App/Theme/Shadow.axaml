<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- "Shadow" theme: lighter graphite between dark and light. Merged over the Dark variant by UiHost.ApplyTheme,
       so every Fluent control keeps its dark template and only CLEANit's tokens (and a few Fluent surfaces) change.
       Text tokens ≥ 4.5:1 on the card surface #33353B (see docs/DESIGN.md). -->
  <Color x:Key="ColorBgApp">#2B2D32</Color>
  <Color x:Key="ColorBgSidebar">#33353B</Color>
  <Color x:Key="ColorSurfaceCard">#33353B</Color>
  <Color x:Key="ColorSurfaceRaised">#3C3E45</Color>
  <Color x:Key="ColorSurfaceHover">#45474F</Color>
  <Color x:Key="ColorBorder">#50535C</Color>
  <Color x:Key="ColorAccent">#D81B60</Color>
  <Color x:Key="ColorAccentHover">#E91E63</Color>
  <Color x:Key="ColorAccentPressed">#C2185B</Color>
  <Color x:Key="ColorAccentText">#F48FB1</Color>
  <Color x:Key="ColorAccentSoft">#4D2A3A</Color>
  <Color x:Key="ColorMenuHover">#5A2B40</Color>
  <Color x:Key="ColorTextPrimary">#F4F4F6</Color>
  <Color x:Key="ColorTextSecondary">#C1C4CB</Color>
  <Color x:Key="ColorTextDisabled">#8D9099</Color>
  <Color x:Key="ColorSafe">#60C689</Color>
  <Color x:Key="ColorSafeSoft">#30443A</Color>
  <Color x:Key="ColorModerate">#F5B740</Color>
  <Color x:Key="ColorModerateSoft">#4A3F2C</Color>
  <Color x:Key="ColorDeep">#FF9466</Color>
  <Color x:Key="ColorDeepSoft">#4B3530</Color>
  <Color x:Key="ColorInfo">#74BDE6</Color>
  <Color x:Key="ColorInfoSoft">#2F3E4C</Color>
  <Color x:Key="ColorDanger">#B91C1C</Color>
  <Color x:Key="ColorDangerHover">#DC2626</Color>
  <Color x:Key="ColorDangerPressed">#991B1B</Color>
  <Color x:Key="ColorShadow">#55000000</Color>
  <SolidColorBrush x:Key="BrushBgApp" Color="#2B2D32" />
  <SolidColorBrush x:Key="BrushBgSidebar" Color="#33353B" />
  <SolidColorBrush x:Key="BrushSurfaceCard" Color="#33353B" />
  <SolidColorBrush x:Key="BrushSurfaceRaised" Color="#3C3E45" />
  <SolidColorBrush x:Key="BrushSurfaceHover" Color="#45474F" />
  <SolidColorBrush x:Key="BrushBorder" Color="#50535C" />
  <SolidColorBrush x:Key="BrushAccent" Color="#D81B60" />
  <SolidColorBrush x:Key="BrushAccentHover" Color="#E91E63" />
  <SolidColorBrush x:Key="BrushAccentPressed" Color="#C2185B" />
  <SolidColorBrush x:Key="BrushAccentText" Color="#F48FB1" />
  <SolidColorBrush x:Key="BrushAccentSoft" Color="#4D2A3A" />
  <SolidColorBrush x:Key="BrushMenuHover" Color="#5A2B40" />
  <SolidColorBrush x:Key="BrushTextPrimary" Color="#F4F4F6" />
  <SolidColorBrush x:Key="BrushTextSecondary" Color="#C1C4CB" />
  <SolidColorBrush x:Key="BrushTextDisabled" Color="#8D9099" />
  <SolidColorBrush x:Key="BrushSafe" Color="#60C689" />
  <SolidColorBrush x:Key="BrushSafeSoft" Color="#30443A" />
  <SolidColorBrush x:Key="BrushModerate" Color="#F5B740" />
  <SolidColorBrush x:Key="BrushModerateSoft" Color="#4A3F2C" />
  <SolidColorBrush x:Key="BrushDeep" Color="#FF9466" />
  <SolidColorBrush x:Key="BrushDeepSoft" Color="#4B3530" />
  <SolidColorBrush x:Key="BrushInfo" Color="#74BDE6" />
  <SolidColorBrush x:Key="BrushInfoSoft" Color="#2F3E4C" />
  <SolidColorBrush x:Key="BrushDanger" Color="#B91C1C" />
  <SolidColorBrush x:Key="BrushDangerHover" Color="#DC2626" />
  <SolidColorBrush x:Key="BrushDangerPressed" Color="#991B1B" />
  <SolidColorBrush x:Key="BrushShadow" Color="#55000000" />
  <!-- DataGrid (Avalonia.Controls.DataGrid Fluent theme) in the CLEANit palette -->
  <SolidColorBrush x:Key="DataGridColumnHeaderBackgroundBrush" Color="Transparent" />
  <SolidColorBrush x:Key="DataGridColumnHeaderForegroundBrush" Color="#F48FB1" />
  <SolidColorBrush x:Key="DataGridColumnHeaderHoveredBackgroundBrush" Color="#45474F" />
  <SolidColorBrush x:Key="DataGridColumnHeaderPressedBackgroundBrush" Color="#45474F" />
  <SolidColorBrush x:Key="DataGridColumnHeaderDraggedBackgroundBrush" Color="#45474F" />
  <SolidColorBrush x:Key="DataGridRowHoveredBackgroundColor" Color="#45474F" />
  <SolidColorBrush x:Key="DataGridGridLinesBrush" Color="#50535C" />
  <!-- Fluent surfaces that do not use CLEANit tokens -->
  <SolidColorBrush x:Key="TextControlBackground" Color="#3C3E45" />
  <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#45474F" />
  <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#2B2D32" />
  <SolidColorBrush x:Key="TextControlBorderBrush" Color="#50535C" />
  <SolidColorBrush x:Key="ComboBoxBackground" Color="#3C3E45" />
  <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#45474F" />
  <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#45474F" />
  <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#33353B" />
  <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#50535C" />
  <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#33353B" />
  <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#33353B" />
  <SolidColorBrush x:Key="ToolTipBackground" Color="#3C3E45" />
  <SolidColorBrush x:Key="ButtonBackground" Color="#3C3E45" />
  <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#45474F" />
  <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#50535C" />
  <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#383A40" />
  <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#2B2D32" />
  <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#6A6D76" />
</ResourceDictionary>
