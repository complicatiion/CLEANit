        "%LocalAppData%\\Google\\Chrome\\User Data"
      ],
      "processes": [
        "chrome"
      ]
    },
    {
      "id": "browser.chrome.serviceworker",
      "category": "Google Chrome",
      "categoryDe": "Google Chrome",
      "name": "Offline website data (service workers)",
      "nameDe": "Offline-Websitedaten (Service Worker)",
      "description": "Cached scripts and data websites keep for offline use.",
      "descriptionDe": "Zwischengespeicherte Skripte und Daten, die Websites offline nutzen.",
      "risk": "Moderate",
      "selected": false,
      "targets": [
        {
          "path": "%LocalAppData%\\Google\\Chrome\\User Data\\*\\Service Worker\\CacheStorage",
          "pattern": "*",
          "recursive": true
