        "%LocalAppData%\\Google\\Chrome\\User Data"
      ],
      "processes": [
        "chrome"
      ]
    },
    {
      "id": "browser.chrome.cookies",
      "category": "Google Chrome",
      "categoryDe": "Google Chrome",
      "name": "Cookies",
      "nameDe": "Cookies",
      "description": "All cookies of all profiles. Saved passwords stay untouched.",
      "descriptionDe": "Alle Cookies aller Profile. Gespeicherte Passwörter bleiben unberührt.",
