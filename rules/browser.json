      "selected": false,
      "targets": [
        {
          "path": "%LocalAppData%\\Google\\Chrome\\User Data\\*",
          "pattern": "History;History-journal;Visited Links;Top Sites;Top Sites-journal;Shortcuts;Shortcuts-journal;Network Action Predictor;Network Action Predictor-journal;History Provider Cache",
