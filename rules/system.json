    {
      "id": "sys.memorydumps",
      "category": "Windows",
      "categoryDe": "Windows",
      "name": "System memory dumps",
      "nameDe": "System-Speicherabbilder",
      "description": "MEMORY.DMP, minidumps and live kernel reports. Keep them if you are analysing a blue screen.",
      "descriptionDe": "MEMORY.DMP, Minidumps und Live-Kernel-Berichte. Behalten, wenn ein Bluescreen analysiert werden soll.",
      "risk": "Moderate",
      "selected": false,
      "targets": [
        {
          "path": "%WinDir%",
          "pattern": "MEMORY.DMP",
          "recursive": false
        },
        {
          "path": "%WinDir%\\Minidump",
          "pattern": "*.dmp",
          "recursive": true
        },
        {
          "path": "%WinDir%\\LiveKernelReports",
          "pattern": "*.dmp",
          "recursive": true
        }
      ]
    },
    {
      "id": "sys.logs",
      "category": "Windows",
      "categoryDe": "Windows",
      "name": "Windows log files",
      "nameDe": "Windows-Protokolldateien",
      "description": "Setup, CBS, DISM and update logs older than 7 days. Active logs are skipped.",
      "descriptionDe": "Setup-, CBS-, DISM- und Update-Protokolle älter als 7 Tage. Aktive Protokolle werden übersprungen.",
      "risk": "Safe",
      "selected": true,
      "targets": [
        {
          "path": "%WinDir%\\Logs",
          "pattern": "*.log;*.etl;*.cab;*.old",
          "recursive": true,
          "minAgeHours": 168
        },
        {
          "path": "%WinDir%\\Panther",
          "pattern": "*.log;*.etl",
          "recursive": true,
          "minAgeHours": 168
        },
        {
          "path": "%WinDir%\\Debug",
          "pattern": "*.log",
          "recursive": true,
          "minAgeHours": 168
        },
        {
          "path": "%WinDir%\\SoftwareDistribution\\DataStore\\Logs",
          "pattern": "*.log;*.jrs",
          "recursive": true,
          "minAgeHours": 168
        }
      ]
    },
    {
      "id": "sys.deliveryoptimization",
      "category": "Windows",
      "categoryDe": "Windows",
      "name": "Delivery Optimization cache",
      "nameDe": "Übermittlungsoptimierung-Cache",
      "description": "Update files Windows shares with other PCs. The service is stopped briefly and restored.",
