{
  "area": "System",
  "rules": [
    {
      "id": "sys.temp.user",
      "category": "Windows",
      "categoryDe": "Windows",
      "name": "Temporary files (user)",
      "nameDe": "Temporäre Dateien (Benutzer)",
      "description": "Files in the user's temp folder that were not changed for 24 hours.",
      "descriptionDe": "Dateien im Temp-Ordner des Benutzers, die seit 24 Stunden nicht geändert wurden.",
      "risk": "Safe",
      "selected": true,
      "targets": [
        {
          "path": "%Temp%",
          "pattern": "*",
          "recursive": true,
          "minAgeHours": 24
        }
      ]
    },
    {
      "id": "sys.temp.windows",
      "category": "Windows",
      "categoryDe": "Windows",
      "name": "Temporary files (Windows)",
      "nameDe": "Temporäre Dateien (Windows)",
      "description": "Windows temp folders, files older than 24 hours.",
      "descriptionDe": "Temp-Ordner von Windows, Dateien älter als 24 Stunden.",
      "risk": "Safe",
      "selected": true,
      "targets": [
        {
          "path": "%WinDir%\\Temp",
          "pattern": "*",
          "recursive": true,
          "minAgeHours": 24
        },
        {
          "path": "%WinDir%\\SystemTemp",
          "pattern": "*",
          "recursive": true,
          "minAgeHours": 24
        },
        {
          "path": "%WinDir%\\ServiceProfiles\\LocalService\\AppData\\Local\\Temp",
          "pattern": "*",
          "recursive": true,
          "minAgeHours": 24
        },
        {
          "path": "%WinDir%\\ServiceProfiles\\NetworkService\\AppData\\Local\\Temp",
          "pattern": "*",
          "recursive": true,
          "minAgeHours": 24
        }
      ]
    },
    {
