    {
      "id": "sys.chkdsk",
      "category": "Windows",
      "categoryDe": "Windows",
      "name": "Check Disk fragments",
      "nameDe": "Datenträgerprüfung-Fragmente",
      "description": "FOUND.### folders created by chkdsk. They may contain recovered data – moved to the recycle bin.",
      "descriptionDe": "Von chkdsk erstellte FOUND.###-Ordner. Sie können wiederhergestellte Daten enthalten – werden in den Papierkorb verschoben.",
      "risk": "Moderate",
      "selected": false,
      "targets": [
        {
          "path": "%SystemDrive%\\found.*",
          "pattern": "*.chk",
          "recursive": true
        }
